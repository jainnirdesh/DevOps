pipeline {
    agent any
    options { disableConcurrentBuilds() }
    environment { PATH = "/opt/homebrew/bin:${env.PATH}" }
    stages {
        stage('Build') {
            steps { dir('Lab 4') { sh 'docker build -t lab4-app:1.0 app/ && docker build -t lab4-app:2.0 app-v2/' } }
        }
        stage('Automated Tests') {
            steps { dir('Lab 4') { sh '.venv/bin/python -m pytest ci-testing/test_app.py -v --tb=short' } }
        }
        stage('Vault Secrets') {
            steps { dir('Lab 4') { sh '.venv/bin/python scripts/pipeline_secret.py' } }
        }
        stage('Deploy and Verify') {
            steps {
                dir('Lab 4') {
                    sh 'docker compose -p lab4-bg -f blue-green/docker-compose.yml up -d'
                    sh 'curl --fail --retry 20 --retry-connrefused --retry-delay 1 http://localhost:5300/health'
                }
            }
        }
    }
}
